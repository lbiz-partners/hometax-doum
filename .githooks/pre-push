#!/bin/sh
# 도구 중립 게이트 — 어떤 도구·사람이 push하든 git 계층에서 결정론 게이트를 강제한다.
# 검증 대상은 워킹트리가 아니라 **push되는 커밋**이다: git이 stdin으로 주는 refs를
# 읽어 각 커밋을 임시 디렉토리에 추출해 검사한다 (워킹트리 WIP와 무관 — 2026-08-09
# 리뷰 H-1: 워킹트리 검사는 "깨진 커밋+복구된 워킹트리" 우회와 "정상 커밋+WIP" 오차단
# 을 모두 만든다).
#
# 활성화(클론당 1회): git config core.hooksPath .githooks
# 한계(정직하게): 미활성 클론·git push --no-verify(금지)·GitHub 웹 편집은 CI 사후 검증만.
# fail-open은 node 부재 시에만 — 그 외 이상(리포 확인·추출 실패)은 fail-closed.

cd "$(git rev-parse --show-toplevel)" || { echo "[pre-push] 리포 루트 확인 실패 — push 거부" >&2; exit 1; }

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] node가 없어 게이트를 건너뜁니다 — push 후 CI 결과를 반드시 확인하세요." >&2
  exit 0
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "[pre-push] python3가 없어 설치·패키지 회귀 검사를 할 수 없습니다 — push 거부" >&2
  exit 1
fi

ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue   # 브랜치·태그 삭제 push — 내용 검증 대상 없음

  tmp="$(mktemp -d)" || { echo "[pre-push] 임시 디렉토리 생성 실패 — push 거부" >&2; exit 1; }
  if ! git archive "$local_sha" | tar -x -C "$tmp"; then
    echo "[pre-push] $local_sha 추출 실패 — 검증 불가, push 거부" >&2
    rm -rf "$tmp"; exit 1
  fi

  short="$(printf %.8s "$local_sha")"

  # 버전 역행 차단 — 원격에 이미 있는 버전보다 낮은 VERSION 을 밀면 배포가 되감긴다.
  # 낡은 베이스에서 만든 커밋(사람이든 동기화 자동화든)이 그대로 나가는 사고를 막는다
  # (2026-09-19 적대적 리뷰 10차 Critical: v4.2.0 원격에 v3.10.0 커밋이 대기 중이었다).
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO" ]; then
    strict() { printf '%s' "$1" | tr -d ' \t\r'; }
    new_v="$(strict "$(git show "$local_sha:VERSION" 2>/dev/null | sed -n 's/^version: *//p')")"
    old_v="$(strict "$(git show "$remote_sha:VERSION" 2>/dev/null | sed -n 's/^version: *//p')")"
    if [ -n "$old_v" ] && [ -z "$new_v" ]; then
      echo "[pre-push] 원격에는 VERSION 이 있는데 밀려는 커밋(${short})에는 없습니다 — push 거부" >&2
      rm -rf "$tmp"; fail=1; continue
    fi
    # 비표준 표기는 "비교 생략"이 아니라 거부한다 — 끝 공백 한 칸이나 -rc1 로
    # 버전 가드가 통째로 꺼지던 구멍(13차 M-2 실측).
    for v in "$new_v" "$old_v"; do
      [ -z "$v" ] && continue
      case "$v" in
        *[!0-9.]*|*..*|.*|*.)
          echo "[pre-push] VERSION 표기가 X.Y.Z 가 아닙니다($v) — push 거부" >&2
          rm -rf "$tmp"; fail=1; continue 2 ;;
      esac
    done
    if [ -n "$new_v" ] && [ -n "$old_v" ] && [ "$new_v" != "$old_v" ]; then
      lowest="$(printf '%s\n%s\n' "$new_v" "$old_v" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)"
      if [ "$lowest" = "$new_v" ]; then
        echo "[pre-push] 버전 역행 — push 거부: 원격 ${old_v} → 밀려는 커밋 ${new_v} (${short})" >&2
        echo "  낡은 베이스에서 만든 커밋일 수 있습니다. git fetch 후 origin/main 위로 다시 올리세요." >&2
        rm -rf "$tmp"; fail=1; continue
      fi
    fi
  fi

  echo "[pre-push] ${local_ref} (커밋 ${short}) 게이트 실행 중..." >&2
  if ! (cd "$tmp" && CI=1 node scripts/check.mjs >&2 \
        && CI=1 node scripts/test-receivables.mjs >&2 \
        && CI=1 python3 -B scripts/test-free-release.py >&2); then
    echo "" >&2
    echo "[pre-push] 게이트 실패 — push가 거부되었습니다." >&2
    echo "  검사 기준은 워킹트리가 아니라 **push되는 커밋(${short})** 입니다." >&2
    echo "  커밋을 수정(amend 또는 새 커밋)한 뒤 다시 push하세요. 해소가 불분명하면 사용자와 상의하세요." >&2
    echo "  git push --no-verify 우회는 금지 — 고의 우회는 CI가 사후 적발합니다." >&2
    fail=1
  fi
  rm -rf "$tmp"
done
exit $fail
